# Xamcode Build in Public - Environment Variables
# Copy this file to .env.local and fill in your values

# Supabase (optional - the app runs in demo mode without these)
# These two are public and safe to ship to the browser.
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# This one is SERVER-SIDE ONLY. Never expose it to the browser and never
# commit a real value. It is required for live database writes (waitlist
# signups) and for the seed script.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Seed script only (falls back to NEXT_PUBLIC_SUPABASE_URL if unset).
# SUPABASE_URL=your-supabase-url

# GitHub (optional - for future development tracking)
# GITHUB_TOKEN=your-github-token
# GITHUB_REPO=owner/repo

# Email (optional - NOT implemented yet; do not claim emails are sent)
# EMAIL_SERVICE=resend
# EMAIL_FROM=noreply@example.com

# Main Xamcode public telemetry API (SERVER-SIDE ONLY — Phase 1 read-only).
# Used by src/lib/bip/client.ts via Next proxy routes. Never NEXT_PUBLIC_.
# BIP_BASE_URL=https://xamcode-ai.onrender.com
